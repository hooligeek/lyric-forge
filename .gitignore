# Masters and cover art ARE committed, under label/audio and label/artwork.
# They had no version control and no off-machine copy anywhere else, and the
# ledger's measurements are meaningless without the files they describe.
# Only derived audio is excluded.

# Analyzer cache: deterministic PCM decodes and model output. Reproducible from
# the committed mp3s, ~1.6 GB, so disposable and never committed.
.cache/

*.Zone.Identifier

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Editors / OS
.DS_Store
.idea/
.vscode/
